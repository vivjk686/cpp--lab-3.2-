#include <iostream> 
#include <cmath> 

using namespace std;
int main() 

{ 
	setlocale(LC_ALL, "Ukranian");

	double x;
	double a;
	double b;      // додали значення
	double c;
	double f;

	cout << "a = "; cin >> a;
	cout << "b = "; cin >> b;
	cout << "c = "; cin >> c;
	cout << "x = "; cin >> x;
	
	if ( x < 0.6 && b+c != 0) // umova 1
	{ 
		f = a * pow(x, 2) + pow(b, 2) + c;
	}
	if (x > 0.6 && b + c == 0)
	{
		f = (x - a) / (x - c);
	}
	if (!(x < 0.6 && b + c != 0) && !(x > 0.6 && b + c == 0 )) 
	{
		f = (x / c) + (x / a);
	}
	cout << endl;
	cout << "1) f = " << f << endl;
}
